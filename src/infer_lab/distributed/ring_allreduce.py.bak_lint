"""Ring all-reduce over **real TCP sockets**.

This is the collective that dominates tensor-parallel inference.  The ring
algorithm is bandwidth-optimal: every rank sends and receives exactly
``2 * (N-1)/N * S`` bytes regardless of ``N``, so adding ranks does not increase
per-link traffic -- which is exactly why NCCL uses it over NVLink and InfiniBand.

It runs in two phases, each ``N-1`` steps long:

1. **reduce-scatter** -- after N-1 steps, rank *i* holds the fully reduced
   chunk ``(i+1) mod N`` and nobody holds the whole tensor.
2. **all-gather** -- the reduced chunks are circulated once more so every rank
   ends up with the complete result.

No MPI, no NCCL, no Docker: ranks are threads in this process talking over
loopback TCP with length-prefixed framing.  The *protocol* is real, so the
failure modes (partial reads, dead peers, timeouts) are real too -- see
``health.py`` and ``tests/test_ring_allreduce.py``.
"""

from __future__ import annotations

import socket
import struct
import threading
from dataclasses import dataclass, field

import numpy as np

from infer_lab.utils.logging_conf import get_logger

logger = get_logger(__name__)

_HEADER = struct.Struct("!I")   # 4-byte big-endian payload length
DEFAULT_TIMEOUT = 10.0


class RingError(RuntimeError):
    """Raised on protocol violations, dead peers or timeouts."""


# --------------------------------------------------------------------------- wire
def send_msg(sock: socket.socket, payload: bytes) -> None:
    sock.sendall(_HEADER.pack(len(payload)) + payload)


def recv_exact(sock: socket.socket, n: int) -> bytes:
    """TCP is a byte stream: a single recv() is NOT a message. Loop until complete."""
    chunks: list[bytes] = []
    remaining = n
    while remaining:
        try:
            chunk = sock.recv(remaining)
        except TimeoutError as exc:
            raise RingError(f"timeout waiting for {remaining} more bytes") from exc
        if not chunk:
            raise RingError(f"peer closed connection with {remaining} bytes outstanding")
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def recv_msg(sock: socket.socket) -> bytes:
    header = recv_exact(sock, _HEADER.size)
    (length,) = _HEADER.unpack(header)
    return recv_exact(sock, length)


def encode(array: np.ndarray) -> bytes:
    return np.ascontiguousarray(array, dtype=np.float32).tobytes()


def decode(payload: bytes) -> np.ndarray:
    return np.frombuffer(payload, dtype=np.float32).copy()


# --------------------------------------------------------------------------- node
@dataclass
class RingStats:
    bytes_sent: int = 0
    bytes_received: int = 0
    steps: int = 0

    def as_dict(self) -> dict[str, int]:
        return {"bytes_sent": self.bytes_sent, "bytes_received": self.bytes_received,
                "steps": self.steps}


@dataclass
class RingNode:
    """One rank of the ring."""

    rank: int
    world_size: int
    listener: socket.socket
    next_port: int = 0
    timeout: float = DEFAULT_TIMEOUT
    stats: RingStats = field(default_factory=RingStats)
    result: np.ndarray | None = None
    error: BaseException | None = None

    def _connect_next(self) -> socket.socket:
        sock = socket.create_connection(("127.0.0.1", self.next_port), timeout=self.timeout)
        sock.settimeout(self.timeout)
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        return sock

    def _accept_prev(self) -> socket.socket:
        self.listener.settimeout(self.timeout)
        try:
            conn, _ = self.listener.accept()
        except TimeoutError as exc:
            raise RingError(f"rank {self.rank}: previous peer never connected") from exc
        conn.settimeout(self.timeout)
        conn.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        return conn

    def run(self, tensor: np.ndarray) -> np.ndarray:
        """Execute reduce-scatter + all-gather on ``tensor``."""
        n = self.world_size
        chunks = _split_chunks(tensor, n)

        # Establishing the ring: connect outward first, then accept inward.  With
        # every rank doing the same, the ring closes without a coordinator.
        send_sock = self._connect_next()
        recv_sock = self._accept_prev()

        try:
            # ---- phase 1: reduce-scatter
            for step in range(n - 1):
                send_idx = (self.rank - step) % n
                recv_idx = (self.rank - step - 1) % n
                payload = encode(chunks[send_idx])
                send_msg(send_sock, payload)
                self.stats.bytes_sent += len(payload)
                incoming = recv_msg(recv_sock)
                self.stats.bytes_received += len(incoming)
                chunks[recv_idx] = chunks[recv_idx] + decode(incoming)
                self.stats.steps += 1

            # ---- phase 2: all-gather
            for step in range(n - 1):
                send_idx = (self.rank - step + 1) % n
                recv_idx = (self.rank - step) % n
                payload = encode(chunks[send_idx])
                send_msg(send_sock, payload)
                self.stats.bytes_sent += len(payload)
                incoming = recv_msg(recv_sock)
                self.stats.bytes_received += len(incoming)
                chunks[recv_idx] = decode(incoming)
                self.stats.steps += 1

            self.result = np.concatenate(chunks).astype(np.float32)
            return self.result
        finally:
            for sock in (send_sock, recv_sock, self.listener):
                try:
                    sock.close()
                except OSError:
                    pass

    def theoretical_bytes(self, tensor: np.ndarray) -> int:
        n = self.world_size
        return int(2 * (n - 1) / n * tensor.astype(np.float32).nbytes)


def _split_chunks(tensor: np.ndarray, n: int) -> list[np.ndarray]:
    """Pad-free near-equal split; the ring requires exactly ``n`` chunks."""
    flat = np.ascontiguousarray(tensor, dtype=np.float32).ravel()
    if flat.size < n:
        raise ValueError(f"tensor with {flat.size} elements cannot be split across {n} ranks")
    return [np.array(c, dtype=np.float32) for c in np.array_split(flat, n)]


# ---------------------------------------------------------------------- driver
def run_ring_allreduce(tensors: list[np.ndarray], *, timeout: float = DEFAULT_TIMEOUT,
                       host: str = "127.0.0.1") -> tuple[list[np.ndarray], list[RingStats]]:
    """Run a full ring all-reduce over ``len(tensors)`` thread-backed ranks.

    Returns per-rank results (all identical on success) and per-rank byte counters.
    """
    world_size = len(tensors)
    if world_size < 2:
        raise ValueError("ring all-reduce needs at least 2 ranks")
    shape = np.asarray(tensors[0]).shape
    if any(np.asarray(t).shape != shape for t in tensors):
        raise ValueError("all ranks must contribute the same shape")

    listeners: list[socket.socket] = []
    ports: list[int] = []
    for _ in range(world_size):
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind((host, 0))
        srv.listen(4)
        listeners.append(srv)
        ports.append(srv.getsockname()[1])

    nodes = [
        RingNode(rank=r, world_size=world_size, listener=listeners[r],
                 next_port=ports[(r + 1) % world_size], timeout=timeout)
        for r in range(world_size)
    ]

    def worker(node: RingNode, tensor: np.ndarray) -> None:
        try:
            node.run(tensor)
        except BaseException as exc:  # noqa: BLE001 - propagated to the caller
            node.error = exc

    threads = [threading.Thread(target=worker, args=(nodes[r], tensors[r]),
                                name=f"ring-rank-{r}", daemon=True)
               for r in range(world_size)]
    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout=timeout * 3)

    stuck = [n.rank for n, t in zip(nodes, threads) if t.is_alive()]
    if stuck:
        raise RingError(f"ranks {stuck} did not complete within the timeout")
    failed = [(n.rank, n.error) for n in nodes if n.error is not None]
    if failed:
        rank, exc = failed[0]
        raise RingError(f"rank {rank} failed: {type(exc).__name__}: {exc}") from exc

    results = [n.result.reshape(shape) for n in nodes if n.result is not None]  # type: ignore[union-attr]
    logger.info("ring all-reduce complete",
                extra={"world_size": world_size,
                       "bytes_per_rank": nodes[0].stats.bytes_sent})
    return results, [n.stats for n in nodes]
